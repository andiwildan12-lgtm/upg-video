{"K": {"t1": 7.26, "s1t": 8.38, "t2": 13.5, "bantal": 16.22, "tekan": 18.86, "tarik": 23.66, "rumah": 28.38, "depan": 31.1, "belakang": 32.5, "geser": 34.14, "mm": 36.78, "t3": 39.74, "per": 44.22, "kontrol": 46.14, "s1": 48.46, "s2": 53.42, "s3": 58.02, "kencang": 60.78, "telat": 64.06, "cta": 69.607, "tulis": 71.58, "follow": 74.58, "card": 76.34, "total": 79.54}, "subs": [[0.3, 2.46, "Behel itu nggak <b>\"menarik\"</b> gigi."], [3.02, 5.58, "Gigi bisa pindah karena tulangnya <b>dibongkar,</b>"], [5.66, 6.7, "lalu <b>dibangun</b> lagi."], [7.26, 8.06, "Kok bisa?"], [8.38, 11.58, "Tahap satu, kawat behel memberi <b>dorongan</b> kecil yang"], [11.66, 13.22, "terus-menerus ke gigi."], [13.5, 16.14, "Tahap dua, gigi tertanam di tulang,"], [16.22, 18.38, "diikat jaringan halus seperti <b>bantalan.</b>"], [18.86, 20.14, "Di sisi yang terdorong,"], [20.18, 23.18, "bantalan tertekan dan tubuh <b>mengurai</b> sedikit tulangnya."], [23.66, 27.26, "Di sisi sebaliknya, bantalan tertarik dan tubuh <b>membangun</b>"], [27.3, 27.9, "tulang baru."], [28.38, 31.02, "Bayangin pindah <b>rumah</b> bata demi bata:"], [31.1, 33.74, "dinding depan <b>dibongkar,</b> dinding belakang dibangun."], [34.14, 36.38, "Rumahnya bergeser, tapi tetap kokoh."], [36.78, 39.46, "Rata-rata sekitar satu <b>milimeter</b> sebulan."], [39.74, 42.3, "Tahap tiga, begitu gigi bergeser,"], [42.34, 44.14, "<b>dorongan</b> kawat ikut <b>melemah,</b>"], [44.22, 45.9, "seperti per yang sudah <b>kendur.</b>"], [46.14, 48.18, "Makanya <b>kontrol</b> itu penting."], [48.46, 51.34, "Satu, dokter <b>menyetel</b> atau mengganti kawat,"], [51.42, 52.94, "supaya dorongannya aktif lagi."], [53.42, 56.62, "Dua, <b>braket</b> yang lepas dicek sebelum gigi bergeser"], [56.7, 57.98, "ke arah yang salah."], [58.02, 60.46, "Tiga, <b>dorongan</b> dijaga tetap <b>pelan.</b>"], [60.78, 63.98, "Terlalu kencang malah bikin tulang nggak sempat dibangun."], [64.06, 65.58, "Jadi kalau <b>telat</b> kontrol,"], [65.62, 68.54, "gigi berhenti bergeser, dan waktu pakai behel jadi"], [68.62, 69.58, "lebih <b>lama.</b>"], [69.607, 71.5, "Mau dibahas apa lagi soal gigi?"], [71.58, 74.54, "Tulis di <b>komentar,</b> nanti kita jawab lewat video."], [74.58, 75.74, "Jangan lupa <b>follow,</b> ya."]], "words": [[0.3, 0.62, "Behel"], [0.7, 0.94, "itu"], [0.98, 1.1, "nggak"], [1.18, 1.82, "\"menarik\""], [1.9, 2.46, "gigi."], [3.02, 3.26, "Gigi"], [3.3, 3.5, "bisa"], [3.58, 4.06, "pindah"], [4.14, 4.38, "karena"], [4.42, 4.7, "tulangnya"], [4.78, 5.58, "dibongkar,"], [5.66, 5.9, "lalu"], [5.94, 6.3, "dibangun"], [6.42, 6.7, "lagi."], [7.26, 7.34, "Kok"], [7.42, 8.06, "bisa?"], [8.38, 8.62, "Tahap"], [8.7, 9.5, "satu,"], [9.58, 9.82, "kawat"], [9.9, 10.3, "behel"], [10.42, 10.62, "memberi"], [10.66, 10.94, "dorongan"], [11.02, 11.42, "kecil"], [11.5, 11.58, "yang"], [11.66, 12.38, "terus-menerus"], [12.46, 12.54, "ke"], [12.58, 13.22, "gigi."], [13.5, 13.74, "Tahap"], [13.82, 14.54, "dua,"], [14.62, 14.94, "gigi"], [15.02, 15.34, "tertanam"], [15.42, 15.46, "di"], [15.5, 16.14, "tulang,"], [16.22, 16.54, "diikat"], [16.62, 16.94, "jaringan"], [17.02, 17.26, "halus"], [17.38, 17.66, "seperti"], [17.74, 18.38, "bantalan."], [18.86, 18.94, "Di"], [19.02, 19.18, "sisi"], [19.26, 19.34, "yang"], [19.42, 20.14, "terdorong,"], [20.18, 20.54, "bantalan"], [20.62, 21.18, "tertekan"], [21.26, 21.42, "dan"], [21.5, 21.82, "tubuh"], [21.86, 22.3, "mengurai"], [22.38, 22.62, "sedikit"], [22.7, 23.18, "tulangnya."], [23.66, 23.74, "Di"], [23.82, 23.98, "sisi"], [24.06, 25.02, "sebaliknya,"], [25.06, 25.42, "bantalan"], [25.5, 26.06, "tertarik"], [26.14, 26.3, "dan"], [26.38, 26.7, "tubuh"], [26.74, 27.26, "membangun"], [27.3, 27.5, "tulang"], [27.58, 27.9, "baru."], [28.38, 28.78, "Bayangin"], [28.86, 29.1, "pindah"], [29.22, 29.42, "rumah"], [29.58, 29.9, "bata"], [29.98, 30.14, "demi"], [30.22, 31.02, "bata:"], [31.1, 31.34, "dinding"], [31.42, 31.58, "depan"], [31.62, 32.46, "dibongkar,"], [32.5, 32.7, "dinding"], [32.78, 