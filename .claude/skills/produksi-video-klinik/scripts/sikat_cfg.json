{"K": {"fol1": 5.661, "t1": 7.101, "turun": 14.221, "panci": 16.221, "t2": 22.301, "saluran": 27.661, "t3": 29.741, "cairan": 32.141, "ngilu": 36.301, "masalah": 37.741, "ganti": 41.781, "kabar": 44.221, "cara1": 46.541, "cara2": 50.381, "cara3": 54.141, "dokter": 57.341, "ingat": 60.221, "cta": 63.941, "tulis": 65.701, "follow": 68.821, "card": 70.581, "total": 73.781}, "subs": [[0.381, 2.341, "Sikat gigi keras-keras biar bersih?"], [2.621, 5.421, "<b>Justru</b> itu yang bikin gigi <b>ngilu</b> kena dingin."], [5.661, 6.861, "Follow Dalam Gigi, ya."], [7.101, 7.981, "Kok bisa?"], [8.221, 10.861, "Tahap satu, bulu sikat yang keras dan gerakan"], [10.901, 13.941, "maju-mundur yang kuat lama-lama mengikis gusi."], [14.221, 15.941, "Gusinya pelan-pelan <b>turun.</b>"], [16.221, 19.221, "Bayangin <b>panci</b> antilengket digosok pakai sabut kawat."], [19.421, 22.101, "Makin keras digosok, lapisannya makin <b>habis.</b>"], [22.301, 24.981, "Tahap dua, leher gigi jadi <b>terbuka.</b>"], [25.181, 27.581, "Bagian ini nggak dilapisi email yang keras,"], [27.661, 29.581, "isinya ribuan <b>saluran</b> <b>mikro.</b>"], [29.741, 32.061, "Tahap tiga, pas kena minuman dingin,"], [32.141, 33.821, "cairan di <b>saluran</b> itu bergerak,"], [33.901, 36.101, "dan saraf di dalam gigi langsung <b>kaget.</b>"], [36.301, 37.541, "Itu yang terasa ngilu."], [37.741, 40.701, "Masalahnya, banyak orang merasa belum bersih kalau belum"], [40.741, 43.101, "digosok kuat, terus malah ganti ke sikat yang"], [43.181, 44.021, "lebih <b>keras.</b>"], [44.221, 46.341, "Kabar baiknya, ini bisa dicegah."], [46.541, 48.781, "Satu, pakai sikat berbulu <b>lembut,</b>"], [48.861, 50.181, "pegang seperti <b>pensil.</b>"], [50.381, 52.701, "Dua, gerakan pendek dan <b>pelan,</b>"], [52.741, 53.981, "miring ke arah gusi."], [54.141, 57.261, "Tiga, pakai pasta gigi khusus gigi <b>sensitif,</b>"], [57.341, 58.781, "dan kalau ngilunya nggak hilang,"], [58.821, 60.141, "periksa ke dokter gigi."], [60.221, 62.381, "I