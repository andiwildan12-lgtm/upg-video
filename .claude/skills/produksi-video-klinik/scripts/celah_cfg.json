{"K": {"ngorek": 3.26, "justru": 4.86, "fol1": 8.54, "sehat": 9.98, "papila": 11.98, "kok": 14.14, "t1": 15.42, "c1": 17.66, "c2": 23.26, "c2b": 26.5, "kunyah": 28.86, "zip": 33.5, "kuman": 39.18, "darah": 42.7, "takut": 44.62, "cungkil": 48.18, "lega": 50.14, "luka": 51.42, "kabar": 54.7, "cara": 57.1, "rutin": 62.14, "tutup": 66.22, "periksa": 68.5, "ingat": 72.78, "cta": 78.327, "tulis": 80.14, "follow": 82.98, "celah": 4.86, "lewat": 13.58, "c1b": 23.26, "c3": 28.86, "c4": 28.86, "c4b": 28.86, "tanda": 48.18, "makin": 53.5, "card": 84.82, "total": 88.02}, "subs": [[0.3, 2.7, "Makanan sering nyelip di geraham belakang,"], [2.78, 4.46, "terus lidah sibuk ngorek-ngorek?"], [4.86, 7.66, "<b>Justru</b> itu tanda ada <b>celah</b> yang nggak seharusnya"], [7.86, 8.3, "ada."], [8.54, 9.78, "Follow Dalam Gigi, ya."], [9.98, 11.9, "Gigi yang sehat menempel rapat,"], [11.98, 13.9, "gusinya mengisi penuh selanya."], [14.14, 15.1, "Kok bisa nyangkut?"], [15.42, 17.34, "Tahap satu, muncul celah."], [17.66, 20.78, "Biasanya karena <b>lubang</b> tepat di titik tempel gigi,"], [20.82, 22.94, "dindingnya keropos, <b>tempelnya</b> hilang."], [23.26, 24.7, "Atau <b>tambalan</b> yang jelek:"], [24.94, 26.38, "nggak nyentuh gigi sebelah,"], [26.5, 28.54, "atau pinggirnya menonjol seperti <b>tangga.</b>"], [28.86, 30.86, "Tahap dua, tiap mengunyah,"], [30.94, 33.34, "<b>serat</b> makanan terjepit penuh di <b>celah</b> itu."], [33.5, 35.82, "Bayangin <b>resleting</b> yang rusak satu giginya."], [36.14, 38.86, "Tiap ditarik, kainnya nyangkut di tempat yang sama."], [39.18, 41.5, "Tahap tiga, kuman memakannya,"], [41.58, 44.3, "gusi sela meradang dan berdarah pas dibersihkan."], [44.62, 48.14, "Masalahnya, banyak orang malah <b>takut</b> bersihin bagian itu,"], [48.18, 49.98, "lalu <b>dicungkil</b> pakai tusuk gigi."], [50.14, 53.5, "Rasanya lega, tapi gusinya makin turun dan celahnya"], [53.58, 54.54, "makin besar."], [54.7, 56.9, "Kabar baiknya, ini bisa diputus."], [57.1, 60.7, "Satu, setelah makan, bersihkan pelan dengan <b>benang</b> gigi"], [60.86, 61.98, "atau <b>sikat</b> sela."], [62.14, 65.5, "Dua, kalau rutin, satu sampai dua minggu berdarahnya"], [65.58, 65.98, "reda."], [66.22, 68.46, "Tiga, <b>celah</b> nggak menutup sendiri:"], [68.5, 69.9, "periksa ke <b>dokter</b> gigi,"], [69.94, 72.54, "<b>lubang</b> ditambal, <b>tambalan</b> jelek diperbaiki."], [72.78, 75.42, "Ingat, nyangkut di tempat yang sama terus itu"], [75.5, 78.3, "tanda ada celah, bukan salah makanannya."], [78.327, 80.06, "Mau dibahas apa lagi soal gigi?"], [80.14, 82.94, "Tulis di <b>komentar,</b> nanti kita jawab lewat video."], [82.98, 84.22, "Jangan lupa <b>follow,</b> ya."]], "words": [[0.3, 0.7, "Makanan"], [0.78, 1.02, "sering"], [1.06, 1.34, "nyelip"], [1.38, 1.42, "di"], [1.5, 1.74, "geraham"], [1.82, 2.7, "belakang,"], [2.78, 3.1, "terus"], [3.26, 3.5, "lidah"], [3.54, 3.74, "sibuk"], [3.78, 4.46, "ngorek-ngorek?"], [4.86, 5.26, "Justru"], [5.34, 5.58, "itu"], [5.66, 5.98, "tanda"], [6.06, 6.22, "ada"], [6.3, 6.7, "celah"], [6.78, 6.86, "yang"], [6.94, 7.1, "nggak"], [7.18, 7.66, "seharusnya"], [7.86, 8.3, "ada."], [8.54, 8.78, "Follow"], [8.82, 9.02, "Dalam"], [9.1, 9.42, "Gigi,"], [9.5, 9.78, "ya."], [9.98, 10.22, "Gigi"], [10.3, 10.38, "yang"], [10.46, 10.78, "sehat"], [10.86, 11.18, "menempel"], [11.26, 11.9, "rapat,"], [11.98, 12.46, "gusinya"], [12.5, 12.94, "mengisi"], [12.98, 13.233, "penuh"], [13.287, 13.9, "selanya."], [14.14, 14.22, "Kok"], [14.3, 14.46, "bisa"], [14.5, 15.1, "nyangkut?"], [15.42, 15.66, "Tahap"], [15.74, 16.26, "satu,"], [16.46, 16.78, "muncul"], [16.86, 17.34, "celah."], [17.66, 18.22, "Biasanya"], [18.3, 18.54, "karena"], [18.58, 18.94, "lubang"], [19.02, 19.34, "tepat"], [19.42, 19.5, "di"], [19.58, 19.74, "titik"], [19.82, 20.06, "tempel"], [20.14, 20.78, "gigi,"], [20.82, 21.18, "dindingnya"], [21.26, 21.98, "keropos,"], [22.1, 22.46, "tempelnya"], [22.58, 22.94, "hilang."], [23.26, 23.66, "Atau"], [23.74, 24.06, "tambalan"],